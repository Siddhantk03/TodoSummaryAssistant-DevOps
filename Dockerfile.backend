# Build from repository root: docker build -f Dockerfile.backend .
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY Backend/todo-summary-assistant/pom.xml ./pom.xml
RUN mvn -B -q dependency:go-offline
COPY Backend/todo-summary-assistant/src ./src
RUN mvn -B -DskipTests package

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
RUN groupadd --system app && useradd --system --gid app --home-dir /app app
COPY --from=build --chown=app:app /src/target/*.jar /app/app.jar
USER app
EXPOSE 8080
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
